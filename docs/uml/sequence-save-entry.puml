@startuml SafeCore_SaveEntry_Sequence
skinparam backgroundColor white

actor User
participant DashboardController
participant PasswordHintService
participant VaultService
participant EncryptionFactory
participant AESEncryptionStrategy
participant KeyManager
participant PasswordEntryRepository
database PostgreSQL

User -> DashboardController: handleConfirmSave()
activate DashboardController

DashboardController -> DashboardController: validateInput()
alt Input non valido
    DashboardController -> User: showError("Campi obbligatori mancanti")
else Input valido
    DashboardController -> PasswordHintService: evaluatePassword(password)
    activate PasswordHintService
    PasswordHintService --> DashboardController: PasswordHint
    deactivate PasswordHintService

    alt Password debole o poco sicura
        DashboardController -> User: showWarning("Password poco sicura")
        User -> DashboardController: conferma salvataggio
    end

    DashboardController -> VaultService: addEntry(service, username, password, expiry)
    activate VaultService

    VaultService -> EncryptionFactory: getDefaultStrategy()
    activate EncryptionFactory
    EncryptionFactory --> VaultService: AESEncryptionStrategy
    deactivate EncryptionFactory

    VaultService -> AESEncryptionStrategy: encrypt(password.getBytes())
    activate AESEncryptionStrategy
    AESEncryptionStrategy -> AESEncryptionStrategy: generateIV()
    AESEncryptionStrategy -> KeyManager: deriveKey()
    activate KeyManager
    KeyManager --> AESEncryptionStrategy: SecretKey
    deactivate KeyManager
    AESEncryptionStrategy -> AESEncryptionStrategy: cipher.doFinal()
    AESEncryptionStrategy --> VaultService: encryptedPassword (IV + ciphertext)
    deactivate AESEncryptionStrategy

    VaultService -> VaultService: new PasswordEntryEntity()
    VaultService -> VaultService: setServiceName(service)
    VaultService -> VaultService: setUsername(username)
    VaultService -> VaultService: setEncryptedPassword(encrypted)
    VaultService -> VaultService: setExpiresAt(expiry)
    VaultService -> VaultService: setUser(user)

    VaultService -> PasswordEntryRepository: save(passwordEntry)
    activate PasswordEntryRepository
    PasswordEntryRepository -> PostgreSQL: INSERT INTO password_entries (...)
    PostgreSQL --> PasswordEntryRepository: id generato
    PasswordEntryRepository --> VaultService: PasswordEntryEntity salvata
    deactivate PasswordEntryRepository

    VaultService -> VaultService: notifyObservers()
    VaultService --> DashboardController: void
    deactivate VaultService

    DashboardController -> DashboardController: refreshVault()
    DashboardController -> User: showToast("Entry salvata!")
end

deactivate DashboardController

@enduml
