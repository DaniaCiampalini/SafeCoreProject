@startuml SafeCore_Class_Diagram
!theme blueprint
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam defaultTextAlignment left
skinparam class {
    BackgroundColor White
    BorderColor Black
    ArrowColor Black
}

title SafeCore - Class Diagram (Layered Architecture)

' ==================== UI LAYER ====================
package ui <<Rectangle>> #E8F4F8 {
    class RegisterController <<Controller>> {
        - userService: UserService
        - passwordHintService: PasswordHintService
        __
        + handleRegister(): void
        + handlePasswordChange(): void
    }

    class LoginController <<Controller>> {
        - userService: UserService
        __
        + handleLogin(): void
        + handleForgotPassword(): void
    }

    class DashboardController <<Controller>> {
        - vaultService: VaultService
        - auditService: SecurityAuditService
        - safeSendService: SafeSendService
        - passwordGenerator: PasswordGenerator
        __
        + handleAddEntry(): void
        + handleConfirmSave(): void
        + refreshVault(): void
        + handleLogout(): void
    }

    class SafeSendController <<Controller>> {
        - safeSendService: SafeSendService
        __
        + handleCreateLink(): void
    }
}

' ==================== SERVICE LAYER ====================
package service <<Rectangle>> #E8F8E8 {
    interface UserService <<Service>> {
        + register(email: String, password: String): User
        + login(email: String, password: String): Optional<User>
        + logout(): void
    }

    class UserServiceImpl <<Service>> {
        - userRepository: UserRepository
        - passwordHasher: PasswordHasher
        - keyManager: KeyManager
        - strengthEvaluator: PasswordStrengthEvaluator
        __
        + register(email: String, password: String): User
        + login(email: String, password: String): Optional<User>
        + logout(): void
    }

    class VaultService <<Service>> {
        - passwordEntryRepository: PasswordEntryRepository
        - userRepository: UserRepository
        - encryptionStrategy: EncryptionStrategy
        __
        + addEntry(service: String, username: String, plain: String): void
        + getEntriesForCurrentUser(): List<PasswordEntryEntity>
        + decryptPassword(encrypted: byte[]): String
        + deleteEntry(id: UUID): void
    }

    interface SecurityAuditService <<Service>> {
        + runAudit(): AuditResult
    }

    class SecurityAuditServiceImpl <<Service>> {
        - vaultService: VaultService
        - strengthEvaluator: PasswordStrengthEvaluator
        __
        + runAudit(): AuditResult
    }

    interface SafeSendService <<Service>> {
        + createSafeLink(content: String, hours: int): String
        + accessSafeLink(id: UUID, token: String): String
    }

    class SafeSendServiceImpl <<Service>> {
        - safeSendRepository: SafeSendRepository
        - encryptionStrategy: EncryptionStrategy
        - passwordHasher: PasswordHasher
        __
        + createSafeLink(content: String, hours: int): String
        + accessSafeLink(id: UUID, token: String): String
    }
}

' ==================== SECURITY LAYER ====================
package security <<Rectangle>> #FFF8E8 {
    class PasswordGenerator {
        __
        + generateSafe(length: int): String
    }

    class PasswordHasher {
        __
        + hash(plain: String): String
        + verify(plain: String, hash: String): boolean
    }

    note right of PasswordHasher
        BCrypt adaptive hashing
        Work factor: 12
    end note

    interface EncryptionStrategy {
        + encrypt(plaintext: String): byte[]
        + decrypt(ciphertext: byte[]): String
    }

    class AESEncryptionStrategy {
        - keyManager: KeyManager
        __
        + encrypt(plaintext: String): byte[]
        + decrypt(ciphertext: byte[]): String
    }

    note right of AESEncryptionStrategy
        AES-256-CBC
        Unique IV per entry
    end note

    class KeyManager {
        __
        + deriveKey(password: String, salt: byte[]): SecretKey
        + generateSalt(): byte[]
    }

    note right of KeyManager
        PBKDF2 key derivation
    end note

    class PasswordStrengthEvaluator {
        __
        + evaluate(password: String): Strength
        + getScore(password: String): int
    }

    enum Strength <<enumeration>> {
        WEAK
        MEDIUM
        STRONG
    }
}

' ==================== PERSISTENCE LAYER ====================
package persistence <<Rectangle>> #F8E8E8 {
    interface UserRepository <<Repository>> {
        + findByEmail(email: String): Optional<UserEntity>
        + existsByEmail(email: String): boolean
    }

    interface PasswordEntryRepository <<Repository>> {
        + findByUser(user: UserEntity): List<PasswordEntryEntity>
        + deleteByExpiresAtBefore(date: LocalDateTime): void
    }

    interface SafeSendRepository <<Repository>> {
        + findById(id: UUID): Optional<SafeSendEntryEntity>
        + deleteByExpiresAtBefore(date: LocalDateTime): void
    }

    interface PasswordResetTokenRepository <<Repository>> {
        + findByTokenHash(hash: String): Optional<PasswordResetTokenEntity>
        + deleteByExpiryDateBefore(date: LocalDateTime): void
    }

    note bottom of UserRepository
        Extends JpaRepository<UserEntity, UUID>
    end note
}

' ==================== DOMAIN LAYER ====================
package domain <<Rectangle>> {
    class User {
        - id: UUID
        - email: String
        - passwordHash: String
    }

    class PasswordEntry {
        - id: UUID
        - serviceName: String
        - username: String
        - encryptedPassword: byte[]
        - createdAt: LocalDateTime
    }

    class SafeSendEntry {
        - id: UUID
        - encryptedContent: byte[]
        - tokenHash: String
        - expiresAt: LocalDateTime
        - oneTime: boolean
    }

    class PasswordResetToken {
        - id: UUID
        - email: String
        - tokenHash: String
        - expiryDate: LocalDateTime
        - used: boolean
    }

    class UserEntity <<Entity>> {
        - id: UUID
        - email: String
        - passwordHash: String
        - derivationSalt: byte[]
    }

    class PasswordEntryEntity <<Entity>> {
        - id: UUID
        - serviceName: String
        - username: String
        - encryptedPassword: byte[]
        - createdAt: LocalDateTime
        - expiresAt: LocalDateTime
        - user: UserEntity
    }

    class SafeSendEntryEntity <<Entity>> {
        - id: UUID
        - encryptedContent: byte[]
        - tokenHash: String
        - expiresAt: LocalDateTime
        - oneTime: boolean
        - accessCount: int
        - user: UserEntity
    }

    class PasswordResetTokenEntity <<Entity>> {
        - id: UUID
        - email: String
        - tokenHash: String
        - expiryDate: LocalDateTime
        - used: boolean
    }

    class AuditResult {
        + score: int
        + weakCount: int
        + oldCount: int
        + reusedCount: int
        + totalPasswords: int
    }
}

' ==================== RELATIONSHIPS ====================

' UI -> Service Dependencies
RegisterController ..> UserService
LoginController ..> UserService
DashboardController ..> VaultService
DashboardController ..> SecurityAuditService
DashboardController ..> SafeSendService
DashboardController ..> PasswordGenerator
SafeSendController ..> SafeSendService

' Service Interface Realizations
UserService <|.. UserServiceImpl
SecurityAuditService <|.. SecurityAuditServiceImpl
SafeSendService <|.. SafeSendServiceImpl
EncryptionStrategy <|.. AESEncryptionStrategy

' Service -> Repository Dependencies
UserServiceImpl ..> UserRepository
VaultService ..> PasswordEntryRepository
VaultService ..> UserRepository
SafeSendServiceImpl ..> SafeSendRepository

' Service -> Security Dependencies
UserServiceImpl ..> PasswordHasher
UserServiceImpl ..> KeyManager
UserServiceImpl ..> PasswordStrengthEvaluator
VaultService ..> EncryptionStrategy
SafeSendServiceImpl ..> EncryptionStrategy
SafeSendServiceImpl ..> PasswordHasher
SecurityAuditServiceImpl ..> VaultService
SecurityAuditServiceImpl ..> PasswordStrengthEvaluator

' Security Internal Dependencies
AESEncryptionStrategy ..> KeyManager
PasswordStrengthEvaluator ..> Strength

' Repository -> Entity Dependencies
UserRepository ..> UserEntity
PasswordEntryRepository ..> PasswordEntryEntity
SafeSendRepository ..> SafeSendEntryEntity

' Service -> Domain Dependencies
UserServiceImpl ..> User
VaultService ..> PasswordEntry
SafeSendServiceImpl ..> SafeSendEntry
SecurityAuditServiceImpl ..> AuditResult

@enduml


