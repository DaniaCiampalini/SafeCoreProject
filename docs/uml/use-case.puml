@startuml SafeCore_UseCases
!theme plain
left to right direction
skinparam packageStyle rectangle

' ============================================
'  DEFINIZIONE ATTORI
' ============================================

' Attore Base (Generico)
actor "Nuovo Utente" as NewUser

' L'Utente Registrato eredita dal Nuovo Utente
actor "Utente Registrato" as User
User -|> NewUser

' Attore Secondario (a destra)
actor "Destinatario Link" as Recipient <<Secondary>>

' ============================================
'  SISTEMA SAFECORE
' ============================================

rectangle "SafeCore Password Manager" {
    usecase "Registrazione Account" as UC1
    usecase "Login e Sblocco Vault" as UC2
    usecase "Gestione Dashboard Vault" as UC3
    usecase "Inserimento Nuova Credenziale" as UC4
    usecase "Visualizzazione Entry" as UC5
    usecase "Eliminazione Entry" as UC6
    usecase "Generazione Password Casuale" as UC7
    usecase "Audit di Sicurezza" as UC8
    usecase "Creazione Link SafeSend" as UC11
    usecase "Accesso a Segreto SafeSend" as UC12
    usecase "Valutazione Robustezza Password" as UC13
    usecase "Eliminazione Account" as UC15
}

' ============================================
'  ASSOCIAZIONI (CHI FA COSA)
' ============================================

NewUser --> UC1

' Funzioni esclusive dell'utente registrato
User --> UC2
User --> UC3
User --> UC8
User --> UC11
User --> UC15



' Il destinatario esterno (non registrato) accede solo al link
UC12 <-- Recipient

' ============================================
'  RELAZIONI TRA FUNZIONALITÀ
' ============================================

UC3 ..> UC4 : <<include>>
UC3 ..> UC5 : <<include>>
UC3 ..> UC6 : <<include>>

UC1 ..> UC13 : <<include>>
UC4 ..> UC13 : <<include>>
UC8 ..> UC13 : <<include>>

UC4 <.. UC7 : <<extend>>

' ============================================
'  NOTE E LEGENDA
' ============================================

note right of Recipient
  **Attore Secondario**
  Soggetto esterno (non registrato)
  che visualizza il segreto una sola volta.
end note



legend bottom left
  **Legenda UML**
  --|> : Generalizzazione (Ereditarietà)
  --> : Associazione (Interazione)
  ..> <<include>> : Funzione obbligatoria
  <.. <<extend>>  : Funzione opzionale
endlegend

@enduml