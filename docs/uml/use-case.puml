@startuml SafeCore_UseCases
!theme blueprint

left to right direction
skinparam packageStyle rectangle

actor "Utente" as User
actor "Sistema di Sicurezza" as SecuritySystem

rectangle "SafeCore Password Manager" {
    usecase "Registrazione" as UC1
    usecase "Login" as UC2
    usecase "Gestione Vault" as UC3
    usecase "Salvare Entry" as UC4
    usecase "Modificare Entry" as UC5
    usecase "Eliminare Entry" as UC6
    usecase "Generare Password" as UC7
    usecase "Audit di Sicurezza" as UC8
    usecase "Esportare Vault" as UC9
    usecase "SafeSend" as UC10
    usecase "Email Alias" as UC11
    usecase "Criptare Dati" as UC12
    usecase "Hashare Password Utente" as UC13
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7
User --> UC8
User --> UC9
User --> UC10
User --> UC11

UC3 ..> UC4 : <<include>>
UC3 ..> UC5 : <<include>>
UC3 ..> UC6 : <<include>>

UC4 ..> UC12 : <<include>>
UC5 ..> UC12 : <<include>>
UC1 ..> UC13 : <<include>>
UC2 ..> UC13 : <<include>>

SecuritySystem --> UC12
SecuritySystem --> UC13

UC8 ..> UC3 : <<extend>>
UC7 ..> UC4 : <<extend>>

@enduml
