@startuml SafeCore_UseCases
!theme blueprint

left to right direction
skinparam packageStyle rectangle

actor "Utente" as User
actor "Sistema di Sicurezza" as SecuritySystem

rectangle "SafeCore Password Manager" {
    usecase "Registrazione" as UC1
    usecase "Login" as UC2
    usecase "Gestione Vault" as UC3
    usecase "Salvare Entry" as UC4
    usecase "Visualizzare Entry" as UC5
    usecase "Eliminare Entry" as UC6
    usecase "Generare Password" as UC7
    usecase "Audit di Sicurezza" as UC8
    usecase "Esportare Backup" as UC9
    usecase "Importare Backup" as UC10
    usecase "SafeSend" as UC11
    usecase "Valutare Forza Password" as UC13
    usecase "Cercare Entry" as UC14
    usecase "Criptare Dati" as UC15
    usecase "Hashare Password Utente" as UC16
    usecase "Derivare Chiave Cifratura" as UC17
    usecase "Pulizia Entry Scadute" as UC18
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7
User --> UC8
User --> UC9
User --> UC10
User --> UC11
User --> UC14

UC3 ..> UC4 : <<include>>
UC3 ..> UC5 : <<include>>
UC3 ..> UC6 : <<include>>
UC3 ..> UC14 : <<include>>

UC4 ..> UC15 : <<include>>
UC4 ..> UC13 : <<extend>>
UC5 ..> UC15 : <<include>>
UC1 ..> UC16 : <<include>>
UC1 ..> UC17 : <<include>>
UC2 ..> UC16 : <<include>>
UC2 ..> UC17 : <<include>>

UC7 ..> UC13 : <<extend>>
UC8 ..> UC3 : <<extend>>
UC9 ..> UC15 : <<include>>
UC10 ..> UC15 : <<include>>
UC11 ..> UC15 : <<include>>

UC3 ..> UC18 : <<include>>

SecuritySystem --> UC15
SecuritySystem --> UC16
SecuritySystem --> UC17

@enduml
