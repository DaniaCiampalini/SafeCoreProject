@startuml SafeCore_Package_Diagram

' Configurazione Estetica Generale
top to bottom direction
skinparam linetype ortho
skinparam nodesep 100
skinparam ranksep 80
skinparam shadowing false
skinparam roundcorner 10
skinparam dpi 150

' Stili dei Package
skinparam package {
    BackgroundColor<<ui>> #E3F2FD
    BackgroundColor<<business>> #D5F4E6
    BackgroundColor<<security>> #FFF4CC
    BackgroundColor<<persistence>> #FFE4E1
    BorderColor #333333
    BorderThickness 1.5
    FontSize 13
    FontStyle bold
}

' ========== LAYER 1: PRESENTATION ==========
package "com.safecore.ui" <<ui>> {
    package "controller" as Controller
    package "navigation" as Navigation
    package "session" as Session
}

' ========== LAYER 2: BUSINESS LOGIC ==========
package "com.safecore.business" <<business>> {
    package "service" as Service
    package "domain" as Domain
    package "hints" as Hints
}

' ========== LAYER 3: SECURITY ==========
package "com.safecore.security" <<security>> {
    ' Logica di cifratura (AES) e hashing (BCrypt)
}

' ========== LAYER 4: PERSISTENCE ==========
package "com.safecore.persistence" <<persistence>> {
    package "entity" as Entity
    package "repository" as Repository
}

' ========== DATABASE ==========
database "PostgreSQL" as DB #White

' ========== RELAZIONI (DIPENDENZE) ==========

' UI -> Business
Controller ..> Service : <<invokes>>
Controller ..> Domain : <<uses>>
Session ..> Domain : <<uses>>

' Business -> Security & Persistence
Service ..> Hints : <<uses>>
Service ..> "com.safecore.security" : <<uses>>
Service ..> Repository : <<persists>>
Service ..> Domain : <<manipulates>>

' Persistence -> DB
Repository ..> Entity : <<manages>>
Entity -- DB : <<mapped>>

' Allineamento forzato per mantenere la struttura a livelli
"com.safecore.ui" -[hidden]down-> "com.safecore.business"
"com.safecore.business" -[hidden]down-> "com.safecore.security"
"com.safecore.security" -[hidden]down-> "com.safecore.persistence"

' Legenda
legend bottom left
    |= Colore |= Layer |
    | <#E3F2FD> | UI (Presentation) |
    | <#D5F4E6> | Business Logic |
    | <#FFF4CC> | Security (Crypto) |
    | <#FFE4E1> | Persistence |
endlegend

@enduml