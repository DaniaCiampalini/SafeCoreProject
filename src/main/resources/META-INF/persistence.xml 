<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://xmlns.jcp.org/xml/ns/persistence"
             version="2.2">

    <persistence-unit name="safecorePU">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.safecore.persistence.entity.UserEntity</class>

        <properties>

            <!-- Driver JDBC -->
            <property name="javax.persistence.jdbc.driver"
                      value="org.postgresql.Driver"/>

            <!-- URL del database -->
            <property name="javax.persistence.jdbc.url"
                      value="jdbc:postgresql://localhost:5432/safecore"/>

            <!-- Credenziali (solo didattiche) -->
            <property name="javax.persistence.jdbc.user"
                      value="postgres"/>
            <property name="javax.persistence.jdbc.password"
                      value="password"/>

            <!-- Configurazione Hibernate -->
            <property name="hibernate.dialect"
                      value="org.hibernate.dialect.PostgreSQLDialect"/>

            <!-- Crea/aggiorna lo schema automaticamente -->
            <property name="hibernate.hbm2ddl.auto"
                      value="update"/>

            <!-- Mostra SQL in console (debug) -->
            <property name="hibernate.show_sql"
                      value="true"/>

        </properties>
    </persistence-unit>
</persistence>
