<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml" xmlns="http://javafx.com/javafx/17"
           fx:controller="com.safecore.ui.controller.DashboardController">

    <BorderPane fx:id="mainContent" style="-fx-background-color: #f9fafb;">

        <top>
            <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 15 30; -fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 1);">
                <Label text="SafeCore Vault" style="-fx-font-weight: 800; -fx-font-size: 20; -fx-text-fill: #1e3a8a;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="15" alignment="CENTER_RIGHT">
                    <Label fx:id="userLabel" text="utente@esempio.it" style="-fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
                    <Button text="Esci" onAction="#handleLogout"
                            style="-fx-background-color: #fee2e2; -fx-text-fill: #ef4444; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 8;"/>
                </HBox>
            </HBox>
        </top>

        <center>
            <VBox spacing="25" style="-fx-padding: 30;">

                <FlowPane hgap="20" vgap="20" alignment="CENTER">

                    <VBox prefWidth="280" spacing="12" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                        <Label text="Password Generator" style="-fx-font-weight: 800; -fx-text-fill: #1e3a8a; -fx-font-size: 16;"/>
                        <Label text="Crea password ultra-sicure istantaneamente." wrapText="true" style="-fx-font-size: 13; -fx-text-fill: #6b7280;"/>
                        <Region VBox.vgrow="ALWAYS" prefHeight="10"/>
                        <Button text="Genera &amp; Copia" onAction="#handleGeneratePassword"
                                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8;" maxWidth="Infinity"/>
                    </VBox>

                    <VBox prefWidth="280" spacing="12" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                        <Label text="Vault Status" style="-fx-font-weight: 800; -fx-text-fill: #1e3a8a; -fx-font-size: 16;"/>
                        <Label text="Protezione attiva: AES-256 GCM." wrapText="true" style="-fx-font-size: 13; -fx-text-fill: #6b7280;"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label fx:id="healthScoreLabel" text="--/100" style="-fx-font-size: 24; -fx-font-weight: 800;"/>
                            <VBox>
                                <Label text="Punteggio Salute" style="-fx-font-size: 11; -fx-text-fill: #6b7280;"/>
                                <Label fx:id="auditDetailLabel" text="Analisi in corso..." style="-fx-font-size: 11; -fx-text-fill: #6b7280;"/>
                            </VBox>
                        </HBox>

                        <Region VBox.vgrow="ALWAYS" prefHeight="10"/>

                        <Button text="Esegui Analisi Completa" onAction="#handleFullAudit"
                                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8;" maxWidth="Infinity"/>
                    </VBox>

                    <VBox prefWidth="280" spacing="12" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                        <Label text="SafeSend" style="-fx-font-weight: 800; -fx-text-fill: #1e3a8a; -fx-font-size: 16;"/>
                        <Label text="Invia testi cifrati con link a scadenza monouso." wrapText="true" style="-fx-font-size: 13; -fx-text-fill: #6b7280;"/>
                        <Region VBox.vgrow="ALWAYS" prefHeight="10"/>
                        <Button text="Nuovo Link Sicuro" onAction="#handleNewSafeSend"
                                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8;" maxWidth="Infinity"/>
                    </VBox>

                    <VBox prefWidth="280" spacing="12" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                        <Label text="Security Backup" style="-fx-font-weight: 800; -fx-text-fill: #1e3a8a; -fx-font-size: 16;"/>
                        <Label text="Esporta o ripristina il tuo database cifrato." wrapText="true" style="-fx-font-size: 13; -fx-text-fill: #6b7280;"/>
                        <Region VBox.vgrow="ALWAYS" prefHeight="10"/>
                        <HBox spacing="10">
                            <Button text="Esporta" onAction="#handleBackup" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                    style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8;"/>
                            <Button text="Importa" onAction="#handleImport" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                    style="-fx-background-color: #4b5563; -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 8;"/>
                        </HBox>
                    </VBox>

                </FlowPane>

                <VBox spacing="15" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 15, 0, 0, 5);">
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <TextField fx:id="searchField" promptText="Cerca servizio o username..." HBox.hgrow="ALWAYS"
                                   style="-fx-background-radius: 20; -fx-padding: 8 15; -fx-border-color: #e5e7eb; -fx-border-radius: 20;"/>
                        <Button text="+ Aggiungi Password" onAction="#handleAddEntry"
                                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20; -fx-padding: 8 20; -fx-cursor: hand;"/>
                    </HBox>

                    <TableView fx:id="passwordTable" VBox.vgrow="ALWAYS" style="-fx-background-radius: 8;">
                        <columns>
                            <TableColumn fx:id="serviceColumn" text="Servizio" prefWidth="250"/>
                            <TableColumn fx:id="usernameColumn" text="Username" prefWidth="250"/>
                            <TableColumn fx:id="actionsColumn" text="Azioni" prefWidth="250"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                    <Label fx:id="toastLabel" style="-fx-text-fill: #15803d; -fx-font-weight: 700;" visible="false"/>
                </VBox>
            </VBox>
        </center>
    </BorderPane>

    <Region fx:id="overlay" visible="false" onMouseClicked="#handleCloseOverlay" style="-fx-background-color: rgba(0,0,0,0.6);"/>

    <VBox fx:id="addEntryCard" visible="false" maxWidth="450" maxHeight="520" spacing="20"
          style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 20, 0, 0, 10);">
        <Label text="Salva Nuova Password" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
        <VBox spacing="15">
            <VBox spacing="5">
                <Label text="Sito o Applicazione" style="-fx-font-weight: bold; -fx-text-fill: #4b5563;"/>
                <TextField fx:id="newServiceField" promptText="es. Google"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Username / Email" style="-fx-font-weight: bold; -fx-text-fill: #4b5563;"/>
                <TextField fx:id="newUsernameField" promptText="es. mario.rossi@gmail.com"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Password" style="-fx-font-weight: bold; -fx-text-fill: #4b5563;"/>
                <PasswordField fx:id="newPasswordField" promptText="••••••••"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Scadenza Automatica" style="-fx-font-weight: bold; -fx-text-fill: #4b5563;"/>
                <ComboBox fx:id="expiryComboBox" maxWidth="Infinity" promptText="Nessuna scadenza"/>
            </VBox>
        </VBox>
        <HBox spacing="15" alignment="CENTER_RIGHT">
            <Button text="Annulla" onAction="#handleCloseOverlay" style="-fx-background-color: #f3f4f6; -fx-background-radius: 8; -fx-cursor: hand;"/>
            <Button text="Salva nel Vault" onAction="#handleConfirmSave"
                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </HBox>
    </VBox>

    <VBox fx:id="generatePasswordCard" visible="false" maxWidth="450" maxHeight="320" spacing="25"
          style="-fx-background-color: white; -fx-padding: 35; -fx-background-radius: 20; -fx-alignment: CENTER;">
        <Label text="Password Generata" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;"/>
        <TextField fx:id="generatedPasswordField" editable="false" alignment="CENTER"
                   style="-fx-font-family: 'Monospaced'; -fx-font-size: 20; -fx-background-color: #f3f4f6; -fx-border-color: #d1d5db; -fx-border-radius: 8;"/>
        <HBox spacing="15" alignment="CENTER">
            <Button text="Chiudi" onAction="#handleCloseOverlay" style="-fx-background-color: #f3f4f6; -fx-background-radius: 8;"/>
            <Button text="Copia e Chiudi" onAction="#handleConfirmCopy"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
        </HBox>
    </VBox>

    <VBox fx:id="safeSendOverlayCard" visible="false" maxWidth="450" alignment="CENTER" />
    <VBox fx:id="auditOverlayCard" visible="false" maxWidth="500" alignment="CENTER" />

</StackPane>