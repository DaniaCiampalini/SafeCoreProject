<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.safecore.ui.controller.DashboardController">

    <!-- LIVELLO 1: DASHBOARD PRINCIPALE -->
    <BorderPane fx:id="mainContent" style="-fx-background-color: #f3f4f6;">
        <top>
            <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-background-color: #111827; -fx-padding: 15;">
                <Label text="SafeCore Vault" style="-fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 18;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="userLabel" style="-fx-text-fill: #9ca3af; -fx-font-weight: bold;"/>
                <Button text="Esci" onAction="#handleLogout"
                        style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </HBox>
        </top>

        <center>
            <VBox spacing="20" style="-fx-padding: 25;">
                <HBox spacing="15">
                    <!-- Card Esistenti (Password Gen, Vault Status, Backup) -->
                    <VBox fx:id="passwordCard" prefWidth="250" spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-radius: 12;">
                        <Label text="Password Generator" style="-fx-font-weight: 800; -fx-text-fill: #374151;"/>
                        <Label text="Crea password sicure al volo." style="-fx-font-size: 11; -fx-text-fill: #6b7280;"/>
                        <Button text="Genera &amp; Copia" onAction="#handleGeneratePassword" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </VBox>
                    <VBox fx:id="vaultCard" prefWidth="250" spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-radius: 12;">
                        <Label text="Vault Status" style="-fx-font-weight: 800; -fx-text-fill: #374151;"/>
                        <Label text="Il tuo archivio è protetto." style="-fx-font-size: 11; -fx-text-fill: #6b7280;"/>
                        <Button text="Aggiorna" onAction="#refreshVault" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </VBox>
                    <VBox fx:id="backupCard" prefWidth="250" spacing="10" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-radius: 12;">
                        <Label text="Security Backup" style="-fx-font-weight: 800; -fx-text-fill: #374151;"/>
                        <Label text="Esporta i dati in formato cifrato." style="-fx-font-size: 11; -fx-text-fill: #6b7280;"/>
                        <Button text="Esegui Backup" onAction="#handleBackup" style="-fx-background-color: #4b5563; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </VBox>
                </HBox>

                <VBox spacing="15" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-radius: 12;">
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <TextField fx:id="searchField" promptText="🔍 Cerca servizio..." prefWidth="350" style="-fx-background-radius: 20;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="+ Aggiungi Segreto" onAction="#handleAddEntry" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    </HBox>
                    <TableView fx:id="passwordTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="serviceColumn" text="Servizio" prefWidth="200"/>
                            <TableColumn fx:id="usernameColumn" text="Username" prefWidth="200"/>
                            <TableColumn fx:id="actionsColumn" text="Azioni" prefWidth="150"/>
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    </TableView>
                </VBox>
            </VBox>
        </center>
    </BorderPane>

    <!-- LIVELLO 2: OVERLAY OSCURANTE (Invisibile all'inizio) -->
    <Region fx:id="overlay" visible="false" onMouseClicked="#handleCloseOverlay"
            style="-fx-background-color: rgba(0,0,0,0.6);"/>

    <!-- LIVELLO 3: CARD MODULO AGGIUNTA (Invisibile all'inizio) -->
    <VBox fx:id="addEntryCard" visible="false" maxWidth="450" maxHeight="400" spacing="20"
          style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 15, 0, 0, 5);">
        
        <Label text="Nuovo Segreto" style="-fx-font-size: 22; -fx-font-weight: 800; -fx-text-fill: #111827;"/>
        
        <VBox spacing="8">
            <Label text="Sito o Applicazione" style="-fx-font-weight: bold; -fx-text-fill: #4b5563;"/>
            <TextField fx:id="newServiceField" promptText="es. Instagram" style="-fx-padding: 10;"/>
        </VBox>

        <VBox spacing="8">
            <Label text="Username o Email" style="-fx-font-weight: bold; -fx-text-fill: #4b5563;"/>
            <TextField fx:id="newUsernameField" promptText="es. utente123" style="-fx-padding: 10;"/>
        </VBox>

        <VBox spacing="8">
            <Label text="Password" style="-fx-font-weight: bold; -fx-text-fill: #4b5563;"/>
            <PasswordField fx:id="newPasswordField" promptText="••••••••" style="-fx-padding: 10;"/>
        </VBox>

        <HBox spacing="15" alignment="CENTER_RIGHT">
            <Button text="Annulla" onAction="#handleCloseOverlay"
                    style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-font-weight: bold; -fx-cursor: hand;"/>
            <Button text="Salva Segreto" onAction="#handleConfirmSave"
                    style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 20; -fx-cursor: hand;"/>
        </HBox>
    </VBox>
</StackPane>