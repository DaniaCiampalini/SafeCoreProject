<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.safecore.ui.controller.DashboardController">

    <!-- LIVELLO 1: DASHBOARD PRINCIPALE -->
    <BorderPane fx:id="mainContent" style="-fx-background-color: #f9fafb;">
        <top>
            <HBox spacing="20" alignment="CENTER_LEFT" styleClass="header-bar">
                <Label text="SafeCore Vault" style="-fx-font-weight: 800; -fx-font-size: 20; -fx-text-fill: #1e3a8a;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="15" alignment="CENTER_RIGHT">
                    <Label fx:id="userLabel" style="-fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
                    <Button text="Esci" onAction="#handleLogout" styleClass="button-danger"/>
                </HBox>
            </HBox>
        </top>

        <center>
            <VBox spacing="25" style="-fx-padding: 30;">
                <FlowPane hgap="20" vgap="20" alignment="CENTER">
                    <!-- Card Esistenti (Password Gen, Vault Status, Backup) -->
                    <VBox fx:id="passwordCard" prefWidth="280" spacing="12" styleClass="card">
                        <Label text="Password Generator" style="-fx-font-weight: 800; -fx-text-fill: #1e3a8a; -fx-font-size: 16;"/>
                        <Label text="Crea password ultra-sicure istantaneamente." wrapText="true" style="-fx-font-size: 13; -fx-text-fill: #6b7280;"/>
                        <Region VBox.vgrow="ALWAYS"/>
                        <Button text="Genera &amp; Copia" onAction="#handleGeneratePassword" styleClass="button-primary" maxWidth="Infinity"/>
                    </VBox>
                    <VBox fx:id="vaultCard" prefWidth="280" spacing="12" styleClass="card">
                        <Label text="Vault Status" style="-fx-font-weight: 800; -fx-text-fill: #1e3a8a; -fx-font-size: 16;"/>
                        <Label text="Il tuo archivio è protetto con cifratura AES-256." wrapText="true" style="-fx-font-size: 13; -fx-text-fill: #6b7280;"/>
                        <Region VBox.vgrow="ALWAYS"/>
                        <Button text="Aggiorna" onAction="#refreshVault" styleClass="button-success" maxWidth="Infinity"/>
                    </VBox>
                    <VBox fx:id="backupCard" prefWidth="280" spacing="12" styleClass="card">
                        <Label text="Security Backup" style="-fx-font-weight: 800; -fx-text-fill: #1e3a8a; -fx-font-size: 16;"/>
                        <Label text="Esporta i tuoi dati in un file sicuro di backup." wrapText="true" style="-fx-font-size: 13; -fx-text-fill: #6b7280;"/>
                        <Region VBox.vgrow="ALWAYS"/>
                        <Button text="Esegui Backup" onAction="#handleBackup" styleClass="button-secondary" maxWidth="Infinity"/>
                    </VBox>
                </FlowPane>

                <VBox spacing="15" VBox.vgrow="ALWAYS" styleClass="card">
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <TextField fx:id="searchField" promptText="Cerca servizio o username..." HBox.hgrow="ALWAYS" style="-fx-background-radius: 25;"/>
                        <Region HBox.hgrow="NEVER" prefWidth="20"/>
                        <Button text="+" onAction="#handleAddEntry" styleClass="button-success"/>
                        <Label fx:id="toastLabel" style="-fx-text-fill: #15803d; -fx-font-weight: 700;" visible="false"/>
                    </HBox>
                    <TableView fx:id="passwordTable" VBox.vgrow="ALWAYS" onMouseClicked="#handleTableClick">
                        <columns>
                            <TableColumn fx:id="serviceColumn" text="Servizio" minWidth="100" prefWidth="250"/>
                            <TableColumn fx:id="usernameColumn" text="Username" minWidth="100" prefWidth="250"/>
                            <TableColumn fx:id="actionsColumn" text="Azioni" minWidth="200" prefWidth="220"/>
                        </columns>
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    </TableView>
                </VBox>
            </VBox>
        </center>
    </BorderPane>

    <!-- LIVELLO 2: OVERLAY OSCURANTE (Invisibile all'inizio) -->
    <Region fx:id="overlay" visible="false" onMouseClicked="#handleCloseOverlay"
            style="-fx-background-color: rgba(0,0,0,0.6);"/>

    <!-- LIVELLO 3: CARD MODULO AGGIUNTA (Invisibile all'inizio) -->
    <VBox fx:id="addEntryCard" visible="false" maxWidth="450" maxHeight="500" spacing="20" styleClass="card"
          style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 15, 0, 0, 5);">
        
        <Label text="Salva Password" styleClass="title-label" style="-fx-font-size: 24;"/>
        
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="20">
                <VBox spacing="8">
                    <Label text="Sito o Applicazione" style="-fx-font-weight: 700; -fx-text-fill: #4b5563;"/>
                    <TextField fx:id="newServiceField" promptText="es. Instagram" />
                </VBox>

                <VBox spacing="8">
                    <Label text="Username o Email" style="-fx-font-weight: 700; -fx-text-fill: #4b5563;"/>
                    <TextField fx:id="newUsernameField" promptText="es. utente123" />
                </VBox>

                <VBox spacing="8">
                    <Label text="Password" style="-fx-font-weight: 700; -fx-text-fill: #4b5563;"/>
                    <PasswordField fx:id="newPasswordField" promptText="••••••••" />
                </VBox>
            </VBox>
        </ScrollPane>

        <HBox spacing="15" alignment="CENTER_RIGHT">
            <Button text="Annulla" onAction="#handleCloseOverlay" styleClass="button-secondary"/>
            <Button text="Salva Password" onAction="#handleConfirmSave" styleClass="button-success"/>
        </HBox>
    </VBox>

    <!-- LIVELLO 4: CARD GENERAZIONE PASSWORD (Invisibile all'inizio) -->
    <VBox fx:id="generatePasswordCard" visible="false" maxWidth="450" maxHeight="350" spacing="20" styleClass="card"
          style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.4), 15, 0, 0, 5);">

        <Label text="Genera Password" styleClass="title-label" style="-fx-font-size: 24;"/>

        <VBox spacing="12" alignment="CENTER">
            <Label text="Password Generata:" style="-fx-font-weight: 700; -fx-text-fill: #4b5563;"/>
            <TextField fx:id="generatedPasswordField" editable="false" alignment="CENTER"
                       style="-fx-font-family: 'Monospace'; -fx-font-size: 18; -fx-text-fill: #2563eb; -fx-background-color: #f3f4f6;"/>
        </VBox>

        <Label text="Vuoi copiare questa password negli appunti?" wrapText="true" style="-fx-text-fill: #6b7280;"/>

        <HBox spacing="15" alignment="CENTER_RIGHT">
            <Button text="Chiudi" onAction="#handleCloseOverlay" styleClass="button-secondary"/>
            <Button text="Copia negli Appunti" onAction="#handleConfirmCopy" styleClass="button-primary"/>
        </HBox>
    </VBox>
</StackPane>