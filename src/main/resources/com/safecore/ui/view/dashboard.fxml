<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.safecore.ui.controller.DashboardController"
            style="-fx-background-color: #f3f4f6;">

    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-background-color: #111827; -fx-padding: 15;">
            <Label text="SafeCore Vault" style="-fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 18;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userLabel" style="-fx-text-fill: #9ca3af; -fx-font-weight: bold;"/>
            <Button text="Esci" onAction="#handleLogout" style="-fx-background-color: #dc2626; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-padding: 25;">

            <HBox spacing="15">
                <VBox fx:id="passwordCard" prefWidth="250" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 12; -fx-border-color: #e5e7eb; -fx-border-radius: 12;">
                    <Label text="Quick Generator" style="-fx-font-weight: 800;"/>
                    <Button text="Genera &amp; Copia" onAction="#handleGeneratePassword" style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-margin-top: 10;"/>
                </VBox>
                <Label fx:id="toastLabel" visible="false" style="-fx-background-color: #111827; -fx-text-fill: white; -fx-padding: 10; -fx-background-radius: 8;"/>
            </HBox>

            <VBox spacing="15" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12;">
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <TextField fx:id="searchField" promptText="🔍 Cerca servizio o username..." prefWidth="300" style="-fx-background-radius: 20;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="+ Aggiungi Segreto" onAction="#handleAddEntry" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold;"/>
                    <Button text="Dettagli" onAction="#handleShowPassword" style="-fx-background-color: #6366f1; -fx-text-fill: white;"/>
                </HBox>

                <TableView fx:id="passwordTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="serviceColumn" text="Servizio" prefWidth="180"/>
                        <TableColumn fx:id="usernameColumn" text="Username" prefWidth="180"/>
                        <TableColumn fx:id="actionsColumn" text="Azioni" prefWidth="120" style="-fx-alignment: CENTER;"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>