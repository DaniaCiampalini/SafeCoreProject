<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml" xmlns="http://javafx.com/javafx/17"
           fx:controller="com.safecore.ui.controller.DashboardController">

    <BorderPane fx:id="mainContent" style="-fx-background-color: #f9fafb;">
        <top>
            <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 15 30; -fx-background-color: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 5, 0, 0, 1);">
                <Label text="SafeCore Vault" style="-fx-font-weight: 800; -fx-font-size: 20; -fx-text-fill: #1e3a8a;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="15" alignment="CENTER_RIGHT">
                    <Label fx:id="userLabel" style="-fx-text-fill: #6b7280; -fx-font-weight: 600;"/>
                    <Button text="Esci" onAction="#handleLogout"
                            style="-fx-background-color: #fee2e2; -fx-text-fill: #ef4444; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </HBox>
            </HBox>
        </top>

        <center>
            <VBox spacing="25" style="-fx-padding: 30;">
                <FlowPane hgap="20" vgap="20" alignment="CENTER">

                    <VBox prefWidth="280" spacing="12" styleClass="card" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                        <Label text="Password Generator" style="-fx-font-weight: 800; -fx-text-fill: #1e3a8a; -fx-font-size: 16;"/>
                        <Label text="Crea password ultra-sicure istantaneamente." wrapText="true" style="-fx-font-size: 13; -fx-text-fill: #6b7280;"/>
                        <Region VBox.vgrow="ALWAYS" prefHeight="20"/>
                        <Button text="Genera &amp; Copia" onAction="#handleGeneratePassword"
                                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-cursor: hand;" maxWidth="Infinity"/>
                    </VBox>

                    <VBox prefWidth="280" spacing="12" styleClass="card" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                        <Label text="Vault Status" style="-fx-font-weight: 800; -fx-text-fill: #1e3a8a; -fx-font-size: 16;"/>
                        <Label text="Il tuo archivio è protetto con cifratura AES-256." wrapText="true" style="-fx-font-size: 13; -fx-text-fill: #6b7280;"/>
                        <Region VBox.vgrow="ALWAYS" prefHeight="20"/>
                        <Button text="Aggiorna" onAction="#refreshVault"
                                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-cursor: hand;" maxWidth="Infinity"/>
                    </VBox>

                    <VBox prefWidth="280" spacing="12" styleClass="card" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                        <Label text="Security Audit" style="-fx-font-weight: 800; -fx-text-fill: #1e3a8a; -fx-font-size: 16;"/>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label fx:id="healthScoreLabel" text="100/100" style="-fx-font-size: 24; -fx-font-weight: 800; -fx-text-fill: #15803d;"/>
                            <Label text="Health" style="-fx-font-size: 13; -fx-text-fill: #6b7280;"/>
                        </HBox>
                        <Label fx:id="auditDetailLabel" text="Il tuo vault è sicuro." wrapText="true" style="-fx-font-size: 11; -fx-text-fill: #6b7280;"/>
                        <Region VBox.vgrow="ALWAYS" prefHeight="20"/>
                        <Button text="Analisi Approfondita" onAction="#handleFullAudit"
                                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-cursor: hand;" maxWidth="Infinity"/>
                    </VBox>

                    <VBox prefWidth="280" spacing="12" styleClass="card" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                        <Label text="SafeSend" style="-fx-font-weight: 800; -fx-text-fill: #1e3a8a; -fx-font-size: 16;"/>
                        <Label text="Invia testi cifrati con link a scadenza monouso." wrapText="true" style="-fx-font-size: 13; -fx-text-fill: #6b7280;"/>
                        <Region VBox.vgrow="ALWAYS" prefHeight="20"/>
                        <Button text="Nuovo Link Sicuro" onAction="#handleNewSafeSend"
                                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-cursor: hand;" maxWidth="Infinity"/>
                    </VBox>

                    <VBox prefWidth="280" spacing="12" styleClass="card" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                        <Label text="Security Backup" style="-fx-font-weight: 800; -fx-text-fill: #1e3a8a; -fx-font-size: 16;"/>
                        <Label text="Esporta i tuoi dati in un file sicuro di backup." wrapText="true" style="-fx-font-size: 13; -fx-text-fill: #6b7280;"/>
                        <Region VBox.vgrow="ALWAYS" prefHeight="20"/>
                        <Button text="Esegui Backup" onAction="#handleBackup"
                                style="-fx-background-color: #6b7280; -fx-text-fill: white; -fx-cursor: hand;" maxWidth="Infinity"/>
                    </VBox>
                </FlowPane>

                <VBox spacing="15" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <TextField fx:id="searchField" promptText="Cerca servizio o username..." HBox.hgrow="ALWAYS" style="-fx-background-radius: 20;"/>
                        <Button text="+" onAction="#handleAddEntry"
                                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 50; -fx-min-width: 40; -fx-min-height: 40; -fx-cursor: hand;"/>
                        <Label fx:id="toastLabel" style="-fx-text-fill: #15803d; -fx-font-weight: 700;" visible="false"/>
                    </HBox>
                    <TableView fx:id="passwordTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="serviceColumn" text="Servizio" minWidth="100" prefWidth="250"/>
                            <TableColumn fx:id="usernameColumn" text="Username" minWidth="100" prefWidth="250"/>
                            <TableColumn fx:id="actionsColumn" text="Azioni" minWidth="220" prefWidth="250"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>
                </VBox>
            </VBox>
        </center>
    </BorderPane>

    <Region fx:id="overlay" visible="false" onMouseClicked="#handleCloseOverlay" style="-fx-background-color: rgba(0,0,0,0.6);"/>

    <VBox fx:id="addEntryCard" visible="false" maxWidth="450" maxHeight="500" spacing="20" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 15;">
        <Label text="Salva Password" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
        <VBox spacing="15">
            <VBox spacing="5">
                <Label text="Sito o Applicazione" style="-fx-font-weight: bold;"/>
                <TextField fx:id="newServiceField" promptText="es. Google"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Username" style="-fx-font-weight: bold;"/>
                <TextField fx:id="newUsernameField" promptText="es. marios@email.com"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Password" style="-fx-font-weight: bold;"/>
                <PasswordField fx:id="newPasswordField" promptText="••••••••"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Scadenza" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="expiryComboBox" maxWidth="Infinity"/>
            </VBox>
        </VBox>
        <HBox spacing="15" alignment="CENTER_RIGHT">
            <Button text="Annulla" onAction="#handleCloseOverlay" style="-fx-background-color: #f3f4f6; -fx-cursor: hand;"/>
            <Button text="Salva" onAction="#handleConfirmSave" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-cursor: hand;"/>
        </HBox>
    </VBox>

    <VBox fx:id="generatePasswordCard" visible="false" maxWidth="450" maxHeight="300" spacing="20" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 15;">
        <Label text="Genera Password" style="-fx-font-size: 24; -fx-font-weight: bold;"/>
        <TextField fx:id="generatedPasswordField" editable="false" alignment="CENTER" style="-fx-font-family: 'Monospaced'; -fx-font-size: 18;"/>
        <HBox spacing="15" alignment="CENTER_RIGHT">
            <Button text="Chiudi" onAction="#handleCloseOverlay" style="-fx-background-color: #f3f4f6;"/>
            <Button text="Copia &amp; Chiudi" onAction="#handleConfirmCopy" style="-fx-background-color: #2563eb; -fx-text-fill: white;"/>
        </HBox>
    </VBox>

    <VBox fx:id="safeSendOverlayCard" visible="false" maxWidth="450" maxHeight="500" alignment="CENTER" />

    <VBox fx:id="auditOverlayCard" visible="false" maxWidth="500" maxHeight="600" alignment="CENTER" />

</StackPane>