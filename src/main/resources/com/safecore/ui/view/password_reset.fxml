<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml" spacing="10"
      alignment="CENTER"
      xmlns="http://javafx.com/javafx/17"
      fx:controller="com.safecore.ui.controller.PasswordResetController">

    <Label text="Reset Password"/>

    <TextField fx:id="emailField" promptText="Email"/>
    <TextField fx:id="tokenField" promptText="Reset Token"/>
    <PasswordField fx:id="newPasswordField" promptText="New Password"/>

    <Label text="Back to login"
           onMouseClicked="#handleBackToLogin"
           style="-fx-text-fill: blue; -fx-underline: true; -fx-cursor: hand;"/>


    <Button text="Request Token" onAction="#handleRequestToken"/>
    <Button text="Reset Password" onAction="#handleResetPassword"/>
    <Button
            text="Generate Secure Password"
            onAction="#handleGeneratePassword"/>


    <Label fx:id="messageLabel"/>


</VBox>
