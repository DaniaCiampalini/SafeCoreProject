<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="15" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.safecore.ui.controller.SafeSendController"
      style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #e5e7eb; -fx-border-radius: 10;">

    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="SafeSend - Condividi Segreti" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <Separator/>

    <VBox spacing="8">
        <Label text="Crea un nuovo link sicuro" style="-fx-font-weight: bold;"/>
        <TextArea fx:id="safeSendTextArea" promptText="Inserisci qui il segreto..." prefHeight="100" wrapText="true"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Scadenza:"/>
            <ComboBox fx:id="safeSendExpiryCombo"/>
            <Button text="Genera Link" onAction="#handleConfirmSafeSend"
                    style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-cursor: hand;"/>
        </HBox>
    </VBox>

    <Separator/>

    <VBox spacing="8">
        <Label text="Accedi a un link ricevuto" style="-fx-font-weight: bold;"/>
        <TextField fx:id="safeSendIdField" promptText="Incolla qui il link completo o l'ID..."/>
        <Button text="Decifra Messaggio" onAction="#handleAccessSafeSend"
                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-cursor: hand;"/>
        <TextArea fx:id="safeSendResultArea" editable="false" prefHeight="80"
                  style="-fx-control-inner-background: #f9fafb;" promptText="Il contenuto apparirà qui..."/>
    </VBox>
</VBox>