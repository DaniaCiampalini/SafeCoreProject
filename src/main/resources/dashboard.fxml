<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.safecore.ui.controller.DashboardController"
            prefWidth="700"
            prefHeight="450">

    <!-- HEADER -->
    <top>
        <HBox spacing="20"
              padding="15"
              style="-fx-background-color: #2c3e50;">
            <Label text="SafeCore"
                   style="-fx-text-fill: white;
                          -fx-font-size: 20px;
                          -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Logout"
                    onAction="#handleLogout"
                    style="-fx-background-color: #e74c3c;
                           -fx-text-fill: white;" />
        </HBox>
    </top>

    <!-- CENTER CONTENT -->
    <center>
        <VBox spacing="20"
              alignment="CENTER"
              padding="30">

            <Label fx:id="welcomeLabel"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;" />

            <Label fx:id="securityStatusLabel"
                   style="-fx-font-size: 14px;" />

            <Separator/>

            <HBox spacing="20" alignment="CENTER">
                <VBox spacing="10"
                      alignment="CENTER"
                      prefWidth="180"
                      style="-fx-background-color: #ecf0f1;
                             -fx-padding: 15;
                             -fx-background-radius: 8;">
                    <Label text="Password Tools"
                           style="-fx-font-weight: bold;" />
                    <Label text="Generate &amp; manage passwords"
                           wrapText="true"/>
                </VBox>

                <VBox spacing="10"
                      alignment="CENTER"
                      prefWidth="180"
                      style="-fx-background-color: #ecf0f1;
                             -fx-padding: 15;
                             -fx-background-radius: 8;">
                    <Label text="Account"
                           style="-fx-font-weight: bold;" />
                    <Label text="Security &amp; settings"
                           wrapText="true"/>
                </VBox>
            </HBox>

        </VBox>
    </center>

    <!-- FOOTER -->
    <bottom>
        <HBox alignment="CENTER"
              padding="10"
              style="-fx-background-color: #bdc3c7;">
            <Label text="SafeCore © 2025"/>
        </HBox>
    </bottom>

</BorderPane>
