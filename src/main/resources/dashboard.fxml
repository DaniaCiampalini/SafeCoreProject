<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.safecore.ui.controller.DashboardController"
            style="-fx-background-color: #f9fafb;">

    <!-- HEADER -->
    <top>
        <HBox spacing="20" padding="15"
              style="-fx-background-color: #111827;"
              alignment="CENTER_LEFT">

            <Label text="SafeCore"
                   style="-fx-text-fill: white;
                          -fx-font-size: 20;
                          -fx-font-weight: bold;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="userLabel"
                   style="-fx-text-fill: #d1d5db;"/>

            <Button text="Logout"
                    onAction="#handleLogout"
                    style="-fx-background-color: #ef4444;
                           -fx-text-fill: white;
                           -fx-background-radius: 6;"/>
        </HBox>
    </top>

    <!-- CENTER -->
    <center>
        <VBox spacing="25" padding="30">

            <Label text="Dashboard"
                   style="-fx-font-size: 24;
                          -fx-font-weight: bold;"/>

            <Label fx:id="securityStatusLabel"
                   style="-fx-text-fill: #16a34a;"/>

            <HBox spacing="20">

                <!-- PASSWORD CARD -->
                <VBox fx:id="passwordCard"
                      spacing="10"
                      padding="20"
                      styleClass="card">
                    <Label text="Password Tools"
                           style="-fx-font-weight: bold;"/>
                    <Label text="Generate and test secure passwords"/>
                    <Button text="Generate"
                            onAction="#handleGeneratePassword"/>
                </VBox>

                <!-- VAULT CARD -->
                <VBox fx:id="vaultCard"
                      spacing="10"
                      padding="20"
                      styleClass="card">
                    <Label text="Vault"
                           style="-fx-font-weight: bold;"/>
                    <Label text="View saved secrets (mock)"/>
                    <Button text="Open"
                            onAction="#handleOpenVault"/>
                </VBox>

                <!-- BACKUP CARD -->
                <VBox fx:id="backupCard"
                      spacing="10"
                      padding="20"
                      styleClass="card">
                    <Label text="Backup"
                           style="-fx-font-weight: bold;"/>
                    <Label text="Export encrypted backup"/>
                    <Button text="Export"
                            onAction="#handleBackup"/>
                </VBox>

            </HBox>

            <!-- TOAST -->
            <Label fx:id="toastLabel"
                   visible="false"
                   style="-fx-background-color: #111827;
                          -fx-text-fill: white;
                          -fx-padding: 10;
                          -fx-background-radius: 8;"/>
        </VBox>
    </center>
</BorderPane>
