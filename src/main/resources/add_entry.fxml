<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<VBox xmlns:fx="http://javafx.com/fxml" spacing="15" xmlns="http://javafx.com/javafx/17"
      fx:controller="com.safecore.ui.controller.AddEntryController"
      style="-fx-background-color: white; -fx-padding: 25; -fx-pref-width: 400;">

    <Label text="Aggiungi Nuovo Segreto" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
    <Separator/>

    <VBox spacing="5">
        <Label text="Service Name (es. Instagram)" style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
        <TextField fx:id="serviceField" promptText="Nome del servizio..."/>
    </VBox>

    <VBox spacing="5">
        <Label text="Username/Email" style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
        <TextField fx:id="usernameField" promptText="Il tuo username..."/>
    </VBox>

    <VBox spacing="5">
        <Label text="Password" style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
        <PasswordField fx:id="passwordField" promptText="La tua password segreta..."/>
    </VBox>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Annulla" onAction="#handleCancel"
                style="-fx-background-color: #f3f4f6; -fx-text-fill: #374151; -fx-cursor: hand;"/>
        <Button text="Salva Segreto" onAction="#handleSave"
                style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
    </HBox>
</VBox>